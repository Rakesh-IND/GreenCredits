# Backend Environment Variables Template
# Rename this file to .env and populate with production values

APP_NAME="Green Credits Production"
SECRET_KEY="generate_a_secure_random_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Replace this with the actual Netlify or frontend production domain url
CORS_ORIGINS=["http://localhost:5173", "https://your-frontend.netlify.app"]

# Database is set in docker-compose, but if running locally without docker:
# DATABASE_URL="sqlite:///./green_credits.db"
